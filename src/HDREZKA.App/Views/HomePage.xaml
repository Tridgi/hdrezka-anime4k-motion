<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HDREZKA.App.Controls"
    xmlns:api="using:HDREZKA.Core.Api"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="HomeGridItemStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,12,16"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <DataTemplate x:Key="HomeMovieTemplate" x:DataType="api:MovieSimple">
            <controls:MovieCard Movie="{x:Bind}"/>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,12,28,12">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="ContentPanel" Spacing="4">
                <Grid x:Name="HeroCard" Height="380" CornerRadius="16" Margin="0,8,0,8"
                      SizeChanged="HeroCard_SizeChanged">
                    <Border CornerRadius="16" Background="#22000000">
                        <Border.Clip>
                            <RectangleGeometry x:Name="HeroClipRect" Rect="0,0,1200,380"/>
                        </Border.Clip>
                        <Image x:Name="HeroBackdrop" Stretch="UniformToFill" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#66000000" Offset="0"/>
                                <GradientStop Color="#E6000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Padding="22,22,22,38" Margin="58,0,58,0" ColumnSpacing="30" HorizontalAlignment="Center" MaxWidth="1120">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="HeroPosterBorder" CornerRadius="12" Background="#22000000" Width="200" Height="300"
                                VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Border.Clip>
                                <RectangleGeometry x:Name="HeroPosterClip" Rect="0,0,200,300"/>
                            </Border.Clip>
                            <Image x:Name="HeroPoster" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <TextBlock x:Name="HeroKicker" FontSize="13" FontWeight="SemiBold" Foreground="#FFD24A"/>
                            <TextBlock x:Name="HeroTitle" FontSize="30" FontWeight="Bold" Foreground="White"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="HeroDetails" FontSize="13"
                                       Foreground="#D5FFFFFF" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="HeroSynopsis" FontSize="14"
                                       Foreground="#DDFFFFFF" TextWrapping="Wrap" MaxLines="4"
                                       MaxWidth="610" MinHeight="48"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                                <Border x:Name="HeroRatingBadge" Style="{StaticResource RatingBadge}">
                                    <TextBlock x:Name="HeroRatingText" Style="{StaticResource RatingBadgeText}"/>
                                </Border>
                                <Button x:Name="HeroWatchButton" Click="HeroWatchButton_Click"
                                        Style="{ThemeResource AccentButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="HeroPrevButton" Click="HeroPrevButton_Click"
                            Width="40" Height="40" CornerRadius="20" Padding="0"
                            Background="#66000000" BorderThickness="0"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0">
                        <FontIcon Glyph="&#xE76B;" FontSize="14" Foreground="White"/>
                    </Button>
                    <Button x:Name="HeroNextButton" Click="HeroNextButton_Click"
                            Width="40" Height="40" CornerRadius="20" Padding="0"
                            Background="#66000000" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                        <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="White"/>
                    </Button>
                    <StackPanel x:Name="HeroDots" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,17"/>
                </Grid>

                <StackPanel x:Name="ContinueSection" Spacing="0" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ContinueHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="ContinueAllButton" Grid.Column="1" Click="ContinueAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="ContinueAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="ContinueRow" Orientation="Horizontal" Spacing="0"/>
                </StackPanel>

                <StackPanel x:Name="TrackedSection" Spacing="0" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TrackedHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="TrackedAllButton" Grid.Column="1" Click="TrackedAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="TrackedAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="TrackedRow" Orientation="Horizontal" Spacing="0"/>
                </StackPanel>

                <StackPanel x:Name="FilmsSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FilmsHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="FilmsAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="FilmsAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- One horizontal row with reserved zoom clearance, not a wrapping GridView. -->
                    <Grid x:Name="FilmsCarousel" Height="325" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FilmsPrevious" Grid.Column="0" Tag="Films"
                                Click="CarouselPrevious_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                        </Button>
                        <ScrollViewer x:Name="FilmsScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ZoomMode="Disabled">
                            <StackPanel x:Name="FilmsRow" Orientation="Horizontal"
                                        Spacing="9" VerticalAlignment="Top"/>
                        </ScrollViewer>
                        <Button x:Name="FilmsNext" Grid.Column="2" Tag="Films"
                                Click="CarouselNext_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="SeriesSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SeriesHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="SeriesAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="SeriesAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- One horizontal row with reserved zoom clearance, not a wrapping GridView. -->
                    <Grid x:Name="SeriesCarousel" Height="325" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SeriesPrevious" Grid.Column="0" Tag="Series"
                                Click="CarouselPrevious_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                        </Button>
                        <ScrollViewer x:Name="SeriesScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ZoomMode="Disabled">
                            <StackPanel x:Name="SeriesRow" Orientation="Horizontal"
                                        Spacing="9" VerticalAlignment="Top"/>
                        </ScrollViewer>
                        <Button x:Name="SeriesNext" Grid.Column="2" Tag="Series"
                                Click="CarouselNext_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="CartoonsSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CartoonsHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="CartoonsAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="CartoonsAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- One horizontal row with reserved zoom clearance, not a wrapping GridView. -->
                    <Grid x:Name="CartoonsCarousel" Height="325" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CartoonsPrevious" Grid.Column="0" Tag="Cartoons"
                                Click="CarouselPrevious_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                        </Button>
                        <ScrollViewer x:Name="CartoonsScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ZoomMode="Disabled">
                            <StackPanel x:Name="CartoonsRow" Orientation="Horizontal"
                                        Spacing="9" VerticalAlignment="Top"/>
                        </ScrollViewer>
                        <Button x:Name="CartoonsNext" Grid.Column="2" Tag="Cartoons"
                                Click="CarouselNext_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="PopularSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PopularHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="PopularAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="PopularAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- One horizontal row with reserved zoom clearance, not a wrapping GridView. -->
                    <Grid x:Name="PopularCarousel" Height="325" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PopularPrevious" Grid.Column="0" Tag="Popular"
                                Click="CarouselPrevious_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                        </Button>
                        <ScrollViewer x:Name="PopularScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ZoomMode="Disabled">
                            <StackPanel x:Name="PopularRow" Orientation="Horizontal"
                                        Spacing="9" VerticalAlignment="Top"/>
                        </ScrollViewer>
                        <Button x:Name="PopularNext" Grid.Column="2" Tag="Popular"
                                Click="CarouselNext_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="WatchingSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WatchingHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="WatchingAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="WatchingAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- One horizontal row with reserved zoom clearance, not a wrapping GridView. -->
                    <Grid x:Name="WatchingCarousel" Height="325" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="WatchingPrevious" Grid.Column="0" Tag="Watching"
                                Click="CarouselPrevious_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                        </Button>
                        <ScrollViewer x:Name="WatchingScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ZoomMode="Disabled">
                            <StackPanel x:Name="WatchingRow" Orientation="Horizontal"
                                        Spacing="9" VerticalAlignment="Top"/>
                        </ScrollViewer>
                        <Button x:Name="WatchingNext" Grid.Column="2" Tag="Watching"
                                Click="CarouselNext_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="SoonSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SoonHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="SoonAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="SoonAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- One horizontal row with reserved zoom clearance, not a wrapping GridView. -->
                    <Grid x:Name="SoonCarousel" Height="325" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SoonPrevious" Grid.Column="0" Tag="Soon"
                                Click="CarouselPrevious_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                        </Button>
                        <ScrollViewer x:Name="SoonScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ZoomMode="Disabled">
                            <StackPanel x:Name="SoonRow" Orientation="Horizontal"
                                        Spacing="9" VerticalAlignment="Top"/>
                        </ScrollViewer>
                        <Button x:Name="SoonNext" Grid.Column="2" Tag="Soon"
                                Click="CarouselNext_Click"
                                Width="30" Height="46" MinWidth="0" Padding="0"
                                CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- One page-owned preview, above all horizontal ScrollViewers. -->
        <Canvas x:Name="HomePreviewLayer" Canvas.ZIndex="120"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsHitTestVisible="False">
            <Border x:Name="HomePreviewPanel" Width="334" Visibility="Collapsed"
                    CornerRadius="16" Padding="16"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="9">
                    <TextBlock x:Name="HomePreviewHeading" FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <Border Width="42" Height="3" CornerRadius="2"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock x:Name="HomePreviewTitle" FontSize="17"
                               FontWeight="Bold" MaxLines="2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HomePreviewOriginal" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               MaxLines="2" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border x:Name="HomePreviewRBackground" CornerRadius="7"
                                Padding="8,5">
                            <TextBlock x:Name="HomePreviewR" FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="HomePreviewImdbBackground" Visibility="Collapsed"
                                CornerRadius="7" Padding="8,5">
                            <TextBlock x:Name="HomePreviewImdb" FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="HomePreviewKpBackground" Visibility="Collapsed"
                                CornerRadius="7" Padding="8,5">
                            <TextBlock x:Name="HomePreviewKp" FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="HomePreviewDescription" FontSize="12"
                               TextWrapping="Wrap" MaxLines="5"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HomePreviewGenres" FontSize="12"
                               TextWrapping="Wrap" MaxLines="3"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Canvas>

        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" Width="44" Height="44"/>
            <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon Glyph="&#xE783;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ErrorText" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button x:Name="RetryButton" Click="RetryButton_Click" Style="{ThemeResource AccentButtonStyle}"/>
                <Button x:Name="MirrorButton" Click="MirrorButton_Click" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
