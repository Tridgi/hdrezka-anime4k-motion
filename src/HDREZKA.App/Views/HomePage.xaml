<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HDREZKA.App.Controls"
    xmlns:api="using:HDREZKA.Core.Api"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="HomeGridItemStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,12,16"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <DataTemplate x:Key="HomeMovieTemplate" x:DataType="api:MovieSimple">
            <controls:MovieCard Movie="{x:Bind}" RecommendationPreview="True"
                                RecommendationHoverChanged="HomeMovie_HoverChanged"
                                Margin="10,20,18,22" VerticalAlignment="Top"/>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,12,28,12">
        <ScrollViewer x:Name="HomeVerticalScroll" VerticalScrollBarVisibility="Hidden"
                      ViewChanged="HomeVerticalScroll_ViewChanged">
            <StackPanel x:Name="ContentPanel" Spacing="4">
                <Grid x:Name="HeroCard" Height="380" CornerRadius="18"
                      Margin="0,8,0,14" SizeChanged="HeroCard_SizeChanged">
                    <Border CornerRadius="18" Background="#10131A">
                        <Border.Clip>
                            <RectangleGeometry x:Name="HeroClipRect" Rect="0,0,1200,380"/>
                        </Border.Clip>
                        <Image x:Name="HeroBackdrop" Stretch="UniformToFill" Opacity="0.24"/>
                    </Border>
                    <Border CornerRadius="18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E915181D" Offset="0"/>
                                <GradientStop Color="#B512151A" Offset="0.55"/>
                                <GradientStop Color="#EF0D1016" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- Navigation arrows own 40-DIP side gutters and never cover the poster. -->
                    <Grid x:Name="HeroInnerGrid" HorizontalAlignment="Center" MaxWidth="1180"
                          Padding="70,20,70,34" ColumnSpacing="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Oversized rank behind the poster: Netflix-style
                             Top 5 number replaces the small kicker caption. -->
                        <Grid x:Name="HeroArtwork" Width="310" Height="320"
                              VerticalAlignment="Center">
                            <TextBlock x:Name="HeroRankNumber" Text="1"
                                       FontFamily="Arial Black" FontSize="245"
                                       FontWeight="Black" Foreground="#8695A8"
                                       Opacity="0.58" TextWrapping="NoWrap"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                       Margin="-12,0,0,-31"/>
                            <Border x:Name="HeroPosterBorder" Width="200" Height="300"
                                    CornerRadius="13" Background="#272C33"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border.Clip>
                                    <RectangleGeometry x:Name="HeroPosterClip" Rect="0,0,200,300"/>
                                </Border.Clip>
                                <Image x:Name="HeroPoster" Stretch="UniformToFill"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9"
                                    MaxWidth="700">
                            <TextBlock x:Name="HeroTitle" FontSize="31" FontWeight="Bold"
                                       Foreground="White" TextWrapping="Wrap"
                                       MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="HeroDetails" FontSize="13" Foreground="#DCE0E5"
                                       TextWrapping="Wrap" MaxLines="2"/>
                            <TextBlock x:Name="HeroDescription" FontSize="13"
                                       Foreground="#BCC3CB" TextWrapping="Wrap"
                                       MaxLines="4" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="12"
                                        Margin="0,10,0,0">
                                <Border x:Name="HeroRatingBadge" Style="{StaticResource RatingBadge}"
                                        Margin="0,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeroRatingText"
                                               Style="{StaticResource RatingBadgeText}"/>
                                </Border>
                                <Button x:Name="HeroWatchButton" Click="HeroWatchButton_Click"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        MinHeight="38" Padding="20,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Button x:Name="HeroPrevButton" Click="HeroPrevButton_Click"
                            Width="38" Height="44" CornerRadius="12" Padding="0"
                            Background="#66000000" BorderThickness="0"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                        <FontIcon Glyph="&#xE76B;" FontSize="15" Foreground="White"/>
                    </Button>
                    <Button x:Name="HeroNextButton" Click="HeroNextButton_Click"
                            Width="38" Height="44" CornerRadius="12" Padding="0"
                            Background="#66000000" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <FontIcon Glyph="&#xE76C;" FontSize="15" Foreground="White"/>
                    </Button>
                    <StackPanel x:Name="HeroDots" Orientation="Horizontal" Spacing="9"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,13"/>
                </Grid>

                <StackPanel x:Name="ContinueSection" Spacing="0" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ContinueHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="ContinueAllButton" Grid.Column="1" Click="ContinueAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="ContinueAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="ContinueRow" Orientation="Horizontal" Spacing="0"/>
                </StackPanel>

                <StackPanel x:Name="TrackedSection" Spacing="0" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TrackedHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="TrackedAllButton" Grid.Column="1" Click="TrackedAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="TrackedAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="TrackedRow" Orientation="Horizontal" Spacing="0"/>
                </StackPanel>

                <StackPanel x:Name="FilmsSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FilmsHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="FilmsAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="FilmsAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="6" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FilmsPrev" Grid.Column="0" Tag="Films"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65"
                                IsEnabled="False">
                            <FontIcon Glyph="&#xE76B;" FontSize="17"/>
                        </Button>
                        <ScrollViewer x:Name="FilmsScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ViewChanged="HomeRail_ViewChanged">
                            <StackPanel Orientation="Horizontal" Spacing="0" Tag="Films"
                                        PointerWheelChanged="HomeRail_PointerWheelChanged">
                                <ItemsControl x:Name="FilmsGrid"
                                              ItemTemplate="{StaticResource HomeMovieTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button x:Name="FilmsEndButton"
                                        Tag="Films" Click="ShowAll_Click"
                                        VerticalAlignment="Top" Margin="0,12,12,12"
                                        Width="178" Height="198"
                                        Padding="16" CornerRadius="16" BorderThickness="1"
                                        BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <StackPanel VerticalAlignment="Center" Spacing="15">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="34"
                                                  Foreground="White"/>
                                        <TextBlock x:Name="FilmsEndText" FontSize="18" Foreground="White"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="FilmsEndHint" FontSize="11"
                                                   Opacity="0.82" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="White"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="19"
                                                  Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="FilmsNext" Grid.Column="2" Tag="Films"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65">
                            <FontIcon Glyph="&#xE76C;" FontSize="17"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="SeriesSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SeriesHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="SeriesAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="SeriesAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="6" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SeriesPrev" Grid.Column="0" Tag="Series"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65"
                                IsEnabled="False">
                            <FontIcon Glyph="&#xE76B;" FontSize="17"/>
                        </Button>
                        <ScrollViewer x:Name="SeriesScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ViewChanged="HomeRail_ViewChanged">
                            <StackPanel Orientation="Horizontal" Spacing="0" Tag="Series"
                                        PointerWheelChanged="HomeRail_PointerWheelChanged">
                                <ItemsControl x:Name="SeriesGrid"
                                              ItemTemplate="{StaticResource HomeMovieTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button x:Name="SeriesEndButton"
                                        Tag="Series" Click="ShowAll_Click"
                                        VerticalAlignment="Top" Margin="0,12,12,12"
                                        Width="178" Height="198"
                                        Padding="16" CornerRadius="16" BorderThickness="1"
                                        BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <StackPanel VerticalAlignment="Center" Spacing="15">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="34"
                                                  Foreground="White"/>
                                        <TextBlock x:Name="SeriesEndText" FontSize="18" Foreground="White"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SeriesEndHint" FontSize="11"
                                                   Opacity="0.82" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="White"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="19"
                                                  Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="SeriesNext" Grid.Column="2" Tag="Series"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65">
                            <FontIcon Glyph="&#xE76C;" FontSize="17"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="CartoonsSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CartoonsHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="CartoonsAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="CartoonsAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="6" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CartoonsPrev" Grid.Column="0" Tag="Cartoons"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65"
                                IsEnabled="False">
                            <FontIcon Glyph="&#xE76B;" FontSize="17"/>
                        </Button>
                        <ScrollViewer x:Name="CartoonsScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ViewChanged="HomeRail_ViewChanged">
                            <StackPanel Orientation="Horizontal" Spacing="0" Tag="Cartoons"
                                        PointerWheelChanged="HomeRail_PointerWheelChanged">
                                <ItemsControl x:Name="CartoonsGrid"
                                              ItemTemplate="{StaticResource HomeMovieTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button x:Name="CartoonsEndButton"
                                        Tag="Cartoons" Click="ShowAll_Click"
                                        VerticalAlignment="Top" Margin="0,12,12,12"
                                        Width="178" Height="198"
                                        Padding="16" CornerRadius="16" BorderThickness="1"
                                        BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <StackPanel VerticalAlignment="Center" Spacing="15">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="34"
                                                  Foreground="White"/>
                                        <TextBlock x:Name="CartoonsEndText" FontSize="18" Foreground="White"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="CartoonsEndHint" FontSize="11"
                                                   Opacity="0.82" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="White"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="19"
                                                  Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="CartoonsNext" Grid.Column="2" Tag="Cartoons"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65">
                            <FontIcon Glyph="&#xE76C;" FontSize="17"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="PopularSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PopularHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="PopularAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="PopularAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="6" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PopularPrev" Grid.Column="0" Tag="Popular"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65"
                                IsEnabled="False">
                            <FontIcon Glyph="&#xE76B;" FontSize="17"/>
                        </Button>
                        <ScrollViewer x:Name="PopularScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ViewChanged="HomeRail_ViewChanged">
                            <StackPanel Orientation="Horizontal" Spacing="0" Tag="Popular"
                                        PointerWheelChanged="HomeRail_PointerWheelChanged">
                                <ItemsControl x:Name="PopularGrid"
                                              ItemTemplate="{StaticResource HomeMovieTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button x:Name="PopularEndButton"
                                        Tag="Popular" Click="ShowAll_Click"
                                        VerticalAlignment="Top" Margin="0,12,12,12"
                                        Width="178" Height="198"
                                        Padding="16" CornerRadius="16" BorderThickness="1"
                                        BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <StackPanel VerticalAlignment="Center" Spacing="15">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="34"
                                                  Foreground="White"/>
                                        <TextBlock x:Name="PopularEndText" FontSize="18" Foreground="White"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="PopularEndHint" FontSize="11"
                                                   Opacity="0.82" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="White"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="19"
                                                  Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="PopularNext" Grid.Column="2" Tag="Popular"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65">
                            <FontIcon Glyph="&#xE76C;" FontSize="17"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="WatchingSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WatchingHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="WatchingAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="WatchingAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="6" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="WatchingPrev" Grid.Column="0" Tag="Watching"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65"
                                IsEnabled="False">
                            <FontIcon Glyph="&#xE76B;" FontSize="17"/>
                        </Button>
                        <ScrollViewer x:Name="WatchingScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ViewChanged="HomeRail_ViewChanged">
                            <StackPanel Orientation="Horizontal" Spacing="0" Tag="Watching"
                                        PointerWheelChanged="HomeRail_PointerWheelChanged">
                                <ItemsControl x:Name="WatchingGrid"
                                              ItemTemplate="{StaticResource HomeMovieTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button x:Name="WatchingEndButton"
                                        Tag="Watching" Click="ShowAll_Click"
                                        VerticalAlignment="Top" Margin="0,12,12,12"
                                        Width="178" Height="198"
                                        Padding="16" CornerRadius="16" BorderThickness="1"
                                        BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <StackPanel VerticalAlignment="Center" Spacing="15">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="34"
                                                  Foreground="White"/>
                                        <TextBlock x:Name="WatchingEndText" FontSize="18" Foreground="White"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="WatchingEndHint" FontSize="11"
                                                   Opacity="0.82" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="White"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="19"
                                                  Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="WatchingNext" Grid.Column="2" Tag="Watching"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65">
                            <FontIcon Glyph="&#xE76C;" FontSize="17"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="SoonSection" Spacing="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SoonHeader" Style="{StaticResource RowHeaderText}"/>
                        <Button x:Name="SoonAllButton" Grid.Column="1" Click="ShowAll_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="SoonAllText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="6" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SoonPrev" Grid.Column="0" Tag="Soon"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65"
                                IsEnabled="False">
                            <FontIcon Glyph="&#xE76B;" FontSize="17"/>
                        </Button>
                        <ScrollViewer x:Name="SoonScroll" Grid.Column="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      ViewChanged="HomeRail_ViewChanged">
                            <StackPanel Orientation="Horizontal" Spacing="0" Tag="Soon"
                                        PointerWheelChanged="HomeRail_PointerWheelChanged">
                                <ItemsControl x:Name="SoonGrid"
                                              ItemTemplate="{StaticResource HomeMovieTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button x:Name="SoonEndButton"
                                        Tag="Soon" Click="ShowAll_Click"
                                        VerticalAlignment="Top" Margin="0,12,12,12"
                                        Width="178" Height="198"
                                        Padding="16" CornerRadius="16" BorderThickness="1"
                                        BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <StackPanel VerticalAlignment="Center" Spacing="15">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="34"
                                                  Foreground="White"/>
                                        <TextBlock x:Name="SoonEndText" FontSize="18" Foreground="White"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SoonEndHint" FontSize="11"
                                                   Opacity="0.82" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="White"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="19"
                                                  Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="SoonNext" Grid.Column="2" Tag="Soon"
                                Click="HomeRailNav_Click" Width="28" Height="46"
                                VerticalAlignment="Center" Padding="0" MinWidth="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.65">
                            <FontIcon Glyph="&#xE76C;" FontSize="17"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Page-owned preview: never clipped by a horizontal carousel. -->
        <Canvas x:Name="HomePreviewLayer" Canvas.ZIndex="120"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsHitTestVisible="False">
            <Border x:Name="HomePreviewCard" Visibility="Collapsed"
                    Width="324" CornerRadius="16" Padding="16"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="9">
                    <TextBlock x:Name="HomePreviewHeader" FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <Border Height="3" Width="48" CornerRadius="2"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock x:Name="HomePreviewTitle" FontSize="18" FontWeight="Bold"
                               TextWrapping="Wrap" MaxLines="2"/>
                    <TextBlock x:Name="HomePreviewSubtitle" FontSize="12"
                               TextWrapping="Wrap" MaxLines="2"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border x:Name="HomePreviewRezka" CornerRadius="9" Padding="7,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border CornerRadius="4" Background="#4A5660" Padding="4,2">
                                    <TextBlock Text="R" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                <TextBlock x:Name="HomePreviewRezkaText"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="HomePreviewImdb" CornerRadius="9" Padding="7,5"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border CornerRadius="4" Background="#F4C516" Padding="4,2">
                                    <TextBlock Text="IMDb" Foreground="#191919" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                <TextBlock x:Name="HomePreviewImdbText"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="HomePreviewKp" CornerRadius="9" Padding="7,5"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border CornerRadius="4" Background="#FC7937" Padding="4,2">
                                    <TextBlock Text="КП" Foreground="#191919" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                <TextBlock x:Name="HomePreviewKpText"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="HomePreviewDescription" FontSize="12"
                               TextWrapping="Wrap" MaxLines="5"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="HomePreviewGenreRows" Spacing="4"/>
                    <TextBlock x:Name="HomePreviewDirector" FontSize="12" MaxLines="2"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="HomePreviewActors" FontSize="12" MaxLines="3"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Canvas>

        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" Width="44" Height="44"/>
            <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon Glyph="&#xE783;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ErrorText" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button x:Name="RetryButton" Click="RetryButton_Click" Style="{ThemeResource AccentButtonStyle}"/>
                <Button x:Name="MirrorButton" Click="MirrorButton_Click" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
