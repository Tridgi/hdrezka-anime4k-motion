<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HDREZKA.App.Controls"
    xmlns:api="using:HDREZKA.Core.Api"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,12,28,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold"/>
            <!-- A single toolbar; on smaller windows the user can scroll
                 horizontally instead of losing access to a filter. -->
            <ScrollViewer HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <ComboBox x:Name="FilterBox" Width="190"
                              MinWidth="175" VerticalAlignment="Center"
                              SelectionChanged="FilterBox_SelectionChanged"/>
                    <Border Width="1" Height="25" VerticalAlignment="Center"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    <StackPanel x:Name="SectionPanel" Orientation="Horizontal"
                                Spacing="6" VerticalAlignment="Center"/>
                    <Border Width="1" Height="25" VerticalAlignment="Center"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    <ComboBox x:Name="GenreBox" Width="215" MinWidth="180"
                              VerticalAlignment="Center"
                              SelectionChanged="GenreBox_SelectionChanged"/>
                    <Button x:Name="ClearGenreButton" Click="ClearGenreButton_Click"
                            Visibility="Collapsed"
                            Padding="12,6" MinWidth="0"
                            CornerRadius="8" VerticalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <ScrollViewer x:Name="ItemsScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" ViewChanged="ItemsScroll_ViewChanged">
            <StackPanel>
                <GridView ScrollViewer.VerticalScrollBarVisibility="Hidden" x:Name="ItemsGrid" SelectionMode="None" IsItemClickEnabled="False">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="12,18,12,22"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="IsTabStop" Value="False"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="api:MovieSimple">
                            <controls:MovieCard Movie="{x:Bind}" RecommendationPreview="True"
                                                RecommendationHoverChanged="CatalogMovie_HoverChanged"/>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel x:Name="MorePanel" HorizontalAlignment="Center" Margin="0,4,0,24" Spacing="8" Visibility="Collapsed">
                    <ProgressRing x:Name="MoreRing" IsActive="False" Width="28" Height="28"/>
                    <Button x:Name="MoreButton" Click="MoreButton_Click" Style="{ThemeResource AccentButtonStyle}"/>
                </StackPanel>

                <StackPanel x:Name="StatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="0,60,0,0" Visibility="Collapsed">
                    <ProgressRing x:Name="LoadingRing" IsActive="True" Width="40" Height="40"/>
                    <TextBlock x:Name="StateText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="RetryButton" Click="RetryButton_Click" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <!-- One page-level, pointer-transparent preview is not clipped by
             GridView virtualization or an individual poster's hit area. -->
        <Canvas x:Name="CatalogPreviewLayer" Grid.RowSpan="2" Canvas.ZIndex="100"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsHitTestVisible="False">
            <Border x:Name="CatalogPreviewPanel" Width="336" Visibility="Collapsed"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="17">
                <StackPanel Spacing="9">
                    <TextBlock x:Name="CatalogPreviewHeader" FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <Border Width="48" Height="3" CornerRadius="2"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock x:Name="CatalogPreviewTitle" FontSize="18" FontWeight="Bold"
                               MaxLines="2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CatalogPreviewOriginal" FontSize="12"
                               MaxLines="2" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border x:Name="CatalogPreviewRezkaBadge" CornerRadius="8"
                                Padding="9,6" Visibility="Collapsed">
                            <TextBlock x:Name="CatalogPreviewRezka" FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="CatalogPreviewImdbBadge" CornerRadius="8"
                                Padding="9,6" Visibility="Collapsed">
                            <TextBlock x:Name="CatalogPreviewImdb" FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="CatalogPreviewKpBadge" CornerRadius="8"
                                Padding="9,6" Visibility="Collapsed">
                            <TextBlock x:Name="CatalogPreviewKp" FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="CatalogPreviewDescription" FontSize="12"
                               TextWrapping="Wrap" MaxLines="5"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CatalogPreviewGenres" FontSize="12"
                               TextWrapping="Wrap" MaxLines="3"/>
                    <TextBlock x:Name="CatalogPreviewDirector" FontSize="12"
                               TextWrapping="Wrap" MaxLines="2"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="CatalogPreviewActors" FontSize="12"
                               TextWrapping="Wrap" MaxLines="3"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Page>
