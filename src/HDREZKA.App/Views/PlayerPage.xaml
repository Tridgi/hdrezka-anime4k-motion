<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black"
    RequestedTheme="Dark"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- Global shortcuts: work regardless of which control has focus -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Invoked="SeekBackInvoked"/>
        <KeyboardAccelerator Key="Right" Invoked="SeekForwardInvoked"/>
        <KeyboardAccelerator Key="Space" Invoked="PlayPauseInvoked"/>
        <KeyboardAccelerator Key="F" Invoked="FullscreenInvoked"/>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeInvoked"/>
        <KeyboardAccelerator Key="N" Invoked="NextInvoked"/>
        <KeyboardAccelerator Key="P" Invoked="PrevInvoked"/>
        <KeyboardAccelerator Key="Up" Invoked="VolumeUpInvoked"/>
        <KeyboardAccelerator Key="Down" Invoked="VolumeDownInvoked"/>
        <KeyboardAccelerator Key="M" Invoked="MuteInvoked"/>
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootGrid"
          Background="Black"
          IsTabStop="True"
          UseSystemFocusVisuals="False"
          SizeChanged="RootGrid_SizeChanged"
          PointerMoved="RootGrid_PointerMoved"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          >

        <!-- Keep compact transport controls accessible on narrow windows. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ControlSizeStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrevButton.Visibility" Value="Collapsed"/>
                        <Setter Target="NextButton.Visibility" Value="Collapsed"/>
                        <Setter Target="Sep1.Visibility" Value="Collapsed"/>
                        <Setter Target="VolumeIcon.Visibility" Value="Collapsed"/>
                        <Setter Target="VolumeSlider.Visibility" Value="Collapsed"/>
                        <Setter Target="MuteButton.Visibility" Value="Collapsed"/>
                        <Setter Target="SkipOpeningText.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="560"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrevButton.Visibility" Value="Visible"/>
                        <Setter Target="NextButton.Visibility" Value="Visible"/>
                        <Setter Target="Sep1.Visibility" Value="Collapsed"/>
                        <Setter Target="VolumeIcon.Visibility" Value="Collapsed"/>
                        <Setter Target="VolumeSlider.Visibility" Value="Collapsed"/>
                        <Setter Target="MuteButton.Visibility" Value="Visible"/>
                        <Setter Target="SkipOpeningText.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="780"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrevButton.Visibility" Value="Visible"/>
                        <Setter Target="NextButton.Visibility" Value="Visible"/>
                        <Setter Target="Sep1.Visibility" Value="Visible"/>
                        <Setter Target="VolumeIcon.Visibility" Value="Visible"/>
                        <Setter Target="VolumeSlider.Visibility" Value="Visible"/>
                        <Setter Target="MuteButton.Visibility" Value="Visible"/>
                        <Setter Target="SkipOpeningText.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border Background="Black" BorderThickness="0" Margin="0" Padding="0"/>

        <SwapChainPanel x:Name="PlayerElement" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>


        <Border x:Name="TapCatcher"
                Background="Transparent"
                BorderThickness="0" Margin="0" Padding="0"
                IsTabStop="True"
                UseSystemFocusVisuals="False"
                FocusVisualPrimaryThickness="0" FocusVisualSecondaryThickness="0"
                Tapped="TapCatcher_Tapped"
                DoubleTapped="TapCatcher_DoubleTapped"
                RightTapped="TapCatcher_RightTapped"/>

        <Grid x:Name="LoadingPanel" Background="Black" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="0,120,0,0">
                <ProgressRing x:Name="LoadingRing" IsActive="True" Width="56" Height="56" Foreground="White"/>
                <TextBlock x:Name="StatusText" Foreground="#B3FFFFFF" FontSize="13" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                <Button x:Name="MirrorButton" Click="MirrorButton_Click" HorizontalAlignment="Center" Visibility="Collapsed"
                        Background="#33FFFFFF" BorderThickness="0" CornerRadius="8" Padding="14,7"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="OverlayGrid" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left-aligned title and episode; never hide the episode for window size. -->
            <Grid x:Name="TopBar" Grid.Row="0" Padding="12,8,12,10" MinHeight="48"
                  Background="#B3000000" DoubleTapped="TopBar_DoubleTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Click="BackButton_Click" Background="Transparent"
                        BorderThickness="0" Padding="8" CornerRadius="8">
                    <FontIcon Glyph="&#xE72B;" Foreground="White" FontSize="16"/>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,8,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextAlignment="Left"
                               MaxWidth="420" VerticalAlignment="Center"/>
                    <Border x:Name="EpisodeChip" Background="#33FFFFFF" CornerRadius="10"
                            Padding="9,3" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="EpisodeText" Foreground="#E6FFFFFF" FontSize="12"
                                   TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <StackPanel x:Name="HeaderEffectsHost" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <ComboBox x:Name="AnimeBox" SelectionChanged="AnimeBox_SelectionChanged"
                                  MinWidth="146" Padding="8,4" Foreground="White" Background="#33000000"
                                  BorderBrush="#4DFFFFFF" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Anime4K: улучшение изображения"/>
                        <ComboBox x:Name="SmoothBox" SelectionChanged="SmoothBox_SelectionChanged"
                                  MinWidth="146" MaxWidth="170" Padding="8,4" Foreground="White"
                                  Background="#33000000" BorderBrush="#4DFFFFFF" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Плавность: интерполяция кадров"/>
                    </StackPanel>
                    <!-- Hidden source retains quality switching handler for the lower menu. -->
                    <ComboBox x:Name="QualityBox" SelectionChanged="QualityBox_SelectionChanged"
                              Visibility="Collapsed"/>
                    <TextBlock x:Name="PlaybackWarningText" Text="⚠ Пропуски" Foreground="#FFFF7070"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               Visibility="Collapsed" Margin="0,0,2,0"/>
                    <Button x:Name="EpisodeDrawerButton" Click="EpisodeDrawerButton_Click"
                            Background="Transparent" BorderThickness="0" Padding="7"
                            CornerRadius="8" Visibility="Collapsed"
                            ToolTipService.ToolTip="Сезоны и серии"
                            AutomationProperties.Name="Сезоны и серии">
                        <FontIcon Glyph="&#xE8B7;" Foreground="White" FontSize="17"/>
                    </Button>
                    <ToggleButton x:Name="PinButton" Click="PinButton_Click"
                                  Background="Transparent" BorderThickness="0" Padding="7">
                        <FontIcon x:Name="PinIcon" Glyph="&#xE718;" Foreground="White" FontSize="15"/>
                    </ToggleButton>
                    <Button x:Name="MinimizeButton" Click="MinimizeButton_Click"
                            Background="Transparent" BorderThickness="0" Padding="7">
                        <FontIcon Glyph="&#xE921;" Foreground="White" FontSize="15"/>
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click"
                            Background="Transparent" BorderThickness="0" Padding="7">
                        <FontIcon Glyph="&#xE8BB;" Foreground="White" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Button x:Name="BigPlayButton" Click="PlayPauseButton_Click"
                            Background="#E6000000" CornerRadius="44" Width="88" Height="88"
                            BorderBrush="#B3FFFFFF" BorderThickness="2" Padding="0" Opacity="1">
                        <FontIcon x:Name="BigPlayIcon" Glyph="&#xE768;" Foreground="White" FontSize="40"/>
                    </Button>
                </StackPanel>
                <Border x:Name="PlaybackStatsPanel" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,10,16,0"
                        Background="#D9000000" CornerRadius="8" Padding="12,9" MaxWidth="310">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Статистика воспроизведения" Foreground="White"
                                   FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="StatsFpsText" Text="Отрисовка: —" Foreground="#FF9FE6A0"
                                   FontFamily="Consolas" FontSize="12"/>
                        <TextBlock x:Name="StatsDroppedText" Text="Пропуски: —" Foreground="White"
                                   FontFamily="Consolas" FontSize="12"/>
                        <TextBlock x:Name="StatsDetailText" Text="Ожидание воспроизведения" Foreground="#FFDDDDDD"
                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" MaxWidth="285"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="BottomBar" Grid.Row="2" Padding="16,10,16,10" Background="#B3000000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="10" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="0:00" Foreground="White" FontSize="12"
                               VerticalAlignment="Center" MinWidth="44"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="0"
                            Style="{StaticResource PlayerSlider}"
                            ValueChanged="SeekSlider_ValueChanged"
                            PointerPressed="SeekSlider_PointerPressed"
                            PointerReleased="SeekSlider_PointerReleased"
                            PointerCanceled="SeekSlider_PointerCanceled"
                            PointerCaptureLost="SeekSlider_PointerCaptureLost"
                            PointerExited="SeekSlider_PointerExited"/>
                    <TextBlock x:Name="TotalTimeText" Text="0:00" Foreground="White" FontSize="12"
                               VerticalAlignment="Center" MinWidth="44" Grid.Column="2"/>
                </Grid>

                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click"
                                Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" Foreground="White" FontSize="18"/>
                        </Button>
                        <Button x:Name="PrevButton" Click="PrevButton_Click"
                                Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE76B;" Foreground="White" FontSize="16"/>
                        </Button>
                        <Button x:Name="NextButton" Click="NextButton_Click"
                                Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE76C;" Foreground="White" FontSize="16"/>
                        </Button>
                        <Button x:Name="SkipOpeningButton" Click="SkipOpeningButton_Click"
                                Background="Transparent" BorderThickness="0" Padding="8"
                                ToolTipService.ToolTip="Пропустить опенинг (интервал задаётся в настройках)"
                                AutomationProperties.Name="Пропустить опенинг">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB9D;" FontFamily="Segoe MDL2 Assets"
                                          Foreground="White" FontSize="15"/>
                                <TextBlock x:Name="SkipOpeningText" Text="+1:25" Foreground="White"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SpeedButton" Click="SpeedButton_Click"
                                Background="Transparent" BorderThickness="0" Padding="8"
                                ToolTipService.ToolTip="Скорость воспроизведения">
                            <TextBlock x:Name="SpeedText" Text="1x" Foreground="White"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Border x:Name="Sep1" Background="#33FFFFFF"
                                Width="1" Height="22" Margin="7,0,7,0"/>
                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" Foreground="#D9FFFFFF"
                                  FontSize="15" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="110"
                                Style="{StaticResource PlayerSlider}" ValueChanged="VolumeSlider_ValueChanged"
                                Margin="6,0,0,0"/>
                        <Button x:Name="MuteButton" Click="MuteButton_Click"
                                Background="Transparent" BorderThickness="0" Padding="6"
                                ToolTipService.ToolTip="Отключить звук">
                            <FontIcon x:Name="MuteIcon" Glyph="&#xE767;"
                                      Foreground="#D9FFFFFF" FontSize="15"/>
                        </Button>
                        <!-- Hidden source retains subtitle switching handler. -->
                        <ComboBox x:Name="SubtitlesBox" SelectionChanged="SubtitlesBox_SelectionChanged"
                                  Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <Button x:Name="TopBarMoreButton" Click="TopBarMoreButton_Click"
                                Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8"
                                ToolTipService.ToolTip="Дополнительные настройки Anime4K и плавности"
                                AutomationProperties.Name="Дополнительные настройки">
                            <TextBlock Text="✨" FontSize="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="PlaybackSettingsButton" Click="PlaybackSettingsButton_Click"
                                Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8"
                                ToolTipService.ToolTip="Настройки воспроизведения"
                                AutomationProperties.Name="Настройки воспроизведения">
                            <FontIcon Glyph="&#xE713;" Foreground="White" FontSize="16"/>
                        </Button>
                        <Button x:Name="FullscreenButton" Click="FullscreenButton_Click"
                                Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" Foreground="White"
                                      FontSize="15"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="BufferingStatusRow" Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" Visibility="Collapsed">
                    <ProgressRing x:Name="BufferingRing" Width="16" Height="16" IsActive="False" Foreground="White"/>
                    <TextBlock x:Name="BufferingText" Text="Буферизация..." Foreground="#B3FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
        <!-- Thumbnail generation MUST NOT create another SwapChainPanel in this
             visual tree. A transparent swapchain can still be composed above
             video/controls by D3D and previously caused an upper-left rectangle. -->
        <!-- Timeline pointer tooltip; image remains optional on inaccessible streams. -->
        <Canvas x:Name="SeekPreviewOverlay" IsHitTestVisible="False" Visibility="Collapsed">
            <Border x:Name="SeekPreviewBubble" CornerRadius="10" Padding="7"
                    Background="#F3272B33" BorderBrush="#66FFFFFF" BorderThickness="1">
                <StackPanel Spacing="5" Width="178">
                    <Image x:Name="SeekPreviewImage" Width="178" Height="100"
                           Stretch="UniformToFill" Visibility="Collapsed"/>
                    <TextBlock x:Name="SeekPreviewTime" Text="00:00"
                               HorizontalAlignment="Center" FontWeight="SemiBold"
                               FontSize="12" Foreground="White"/>
                </StackPanel>
            </Border>
        </Canvas>
        <!-- Drawer overlays the existing video renderer without reinitializing it. -->
        <Grid x:Name="EpisodeDrawerOverlay" Visibility="Collapsed">
            <Border Background="#48000000" Tapped="EpisodeDrawerBackdrop_Tapped"/>
            <Border x:Name="EpisodeDrawerCard" HorizontalAlignment="Right"
                    VerticalAlignment="Stretch" Width="350"
                    Background="#E9101117" BorderBrush="#44FFFFFF"
                    BorderThickness="1,0,0,0" CornerRadius="14,0,0,14">
                <Grid Padding="20,18,18,18" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Сезоны и серии" Foreground="White"
                                   FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Click="EpisodeDrawerClose_Click"
                                Background="#252F343D" BorderBrush="#28FFFFFF"
                                BorderThickness="1" CornerRadius="8"
                                Width="34" Height="34" ToolTipService.ToolTip="Закрыть меню серий">
                            <FontIcon Glyph="&#xE8BB;" Foreground="White" FontSize="13"/>
                        </Button>
                    </Grid>
                    <ComboBox Grid.Row="1" x:Name="EpisodeSeasonBox"
                              Header="Сезон" HorizontalAlignment="Stretch"
                              Background="#262932" Foreground="White"
                              BorderBrush="#4DFFFFFF" BorderThickness="1"
                              SelectionChanged="EpisodeSeasonBox_SelectionChanged"/>
                    <GridView x:Name="EpisodeDrawerGrid" Grid.Row="2"
                              SelectionMode="None" IsItemClickEnabled="False"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden" Padding="0">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
