<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black"
    RequestedTheme="Dark"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- Global shortcuts: work regardless of which control has focus -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Invoked="SeekBackInvoked"/>
        <KeyboardAccelerator Key="Right" Invoked="SeekForwardInvoked"/>
        <KeyboardAccelerator Key="Space" Invoked="PlayPauseInvoked"/>
        <KeyboardAccelerator Key="F" Invoked="FullscreenInvoked"/>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeInvoked"/>
        <KeyboardAccelerator Key="N" Invoked="NextInvoked"/>
        <KeyboardAccelerator Key="P" Invoked="PrevInvoked"/>
        <KeyboardAccelerator Key="Up" Invoked="VolumeUpInvoked"/>
        <KeyboardAccelerator Key="Down" Invoked="VolumeDownInvoked"/>
        <KeyboardAccelerator Key="M" Invoked="MuteInvoked"/>
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootGrid"
          Background="Black"
          IsTabStop="True"
          UseSystemFocusVisuals="False"
          PointerMoved="RootGrid_PointerMoved"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          KeyDown="RootGrid_KeyDown">

        <!-- Adaptive controls: tiny window keeps only Play/Pause + fullscreen,
             medium and wider shows everything. Last matching state wins. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ControlSizeStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrevButton.Visibility" Value="Collapsed"/>
                        <Setter Target="NextButton.Visibility" Value="Collapsed"/>
                        <Setter Target="Sep1.Visibility" Value="Collapsed"/>
                        <Setter Target="VolumeIcon.Visibility" Value="Collapsed"/>
                        <Setter Target="VolumeSlider.Visibility" Value="Collapsed"/>
                        <Setter Target="MuteButton.Visibility" Value="Collapsed"/>
                        <Setter Target="Sep2.Visibility" Value="Collapsed"/>
                        <Setter Target="SubtitlesBox.Visibility" Value="Collapsed"/>
                        <Setter Target="SpeedButton.Visibility" Value="Collapsed"/>
                        <Setter Target="ZoomButton.Visibility" Value="Collapsed"/>
                        <Setter Target="ExternalButton.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrevButton.Visibility" Value="Visible"/>
                        <Setter Target="NextButton.Visibility" Value="Visible"/>
                        <Setter Target="Sep1.Visibility" Value="Visible"/>
                        <Setter Target="VolumeIcon.Visibility" Value="Visible"/>
                        <Setter Target="VolumeSlider.Visibility" Value="Visible"/>
                        <Setter Target="MuteButton.Visibility" Value="Visible"/>
                        <Setter Target="Sep2.Visibility" Value="Visible"/>
                        <Setter Target="SubtitlesBox.Visibility" Value="Visible"/>
                        <Setter Target="SpeedButton.Visibility" Value="Visible"/>
                        <Setter Target="ZoomButton.Visibility" Value="Visible"/>
                        <Setter Target="ExternalButton.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- Separate breakpoints for the header: at high Windows DPI even a
                 physically large window can have fewer than 980 logical pixels. -->
            <VisualStateGroup x:Name="HeaderSizeStates">
                <VisualState x:Name="CompactHeader">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AnimeBox.Visibility" Value="Collapsed"/>
                        <Setter Target="SmoothBox.Visibility" Value="Collapsed"/>
                        <Setter Target="QualityBox.Visibility" Value="Collapsed"/>
                        <Setter Target="PinButton.Visibility" Value="Collapsed"/>
                        <Setter Target="MinimizeButton.Visibility" Value="Collapsed"/>
                        <Setter Target="EpisodeChipHost.Visibility" Value="Collapsed"/>
                        <Setter Target="TopBarMoreButton.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="FullHeader">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1140"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AnimeBox.Visibility" Value="Visible"/>
                        <Setter Target="SmoothBox.Visibility" Value="Visible"/>
                        <Setter Target="QualityBox.Visibility" Value="Visible"/>
                        <Setter Target="PinButton.Visibility" Value="Visible"/>
                        <Setter Target="MinimizeButton.Visibility" Value="Visible"/>
                        <Setter Target="EpisodeChipHost.Visibility" Value="Visible"/>
                        <Setter Target="TopBarMoreButton.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border Background="Black" BorderThickness="0" Margin="0" Padding="0"/>

        <SwapChainPanel x:Name="PlayerElement" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>


        <Border x:Name="TapCatcher"
                Background="Transparent"
                BorderThickness="0" Margin="0" Padding="0"
                IsTabStop="True"
                UseSystemFocusVisuals="False"
                FocusVisualPrimaryThickness="0" FocusVisualSecondaryThickness="0"
                Tapped="TapCatcher_Tapped"
                DoubleTapped="TapCatcher_DoubleTapped"
                RightTapped="TapCatcher_RightTapped"/>

        <Grid x:Name="LoadingPanel" Background="Black" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="0,120,0,0">
                <ProgressRing x:Name="LoadingRing" IsActive="True" Width="56" Height="56" Foreground="White"/>
                <TextBlock x:Name="StatusText" Foreground="#B3FFFFFF" FontSize="13" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                <Button x:Name="MirrorButton" Click="MirrorButton_Click" HorizontalAlignment="Center" Visibility="Collapsed"
                        Background="#33FFFFFF" BorderThickness="0" CornerRadius="8" Padding="14,7"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="OverlayGrid" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TopBar" Grid.Row="0" Padding="12,8,16,10" MinHeight="48" Background="#B3000000"
                  DoubleTapped="TopBar_DoubleTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Click="BackButton_Click" Background="Transparent" BorderThickness="0"
                        Padding="8" CornerRadius="8">
                    <FontIcon Glyph="&#xE72B;" Foreground="White" FontSize="16"/>
                </Button>

                <!-- A grid constrains the title to available width; a horizontal StackPanel
                     previously let long titles / season chips overlap header actions. -->
                <Grid Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Grid.Column="0" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextAlignment="Left" Margin="0,0,6,0"
                               VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <Grid x:Name="EpisodeChipHost" Grid.Column="1" VerticalAlignment="Center">
                        <Border x:Name="EpisodeChip" Background="#33FFFFFF" CornerRadius="10" Padding="10,3"
                                Visibility="Collapsed">
                            <TextBlock x:Name="EpisodeText" Foreground="#E6FFFFFF" FontSize="12"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ComboBox x:Name="AnimeBox" SelectionChanged="AnimeBox_SelectionChanged"
                              MinWidth="146" Padding="8,4" Foreground="White" Background="#33000000"
                              BorderBrush="#4DFFFFFF" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Anime4K: улучшение аниме на GPU. Качество источника остаётся прежним."/>
                    <ComboBox x:Name="SmoothBox" SelectionChanged="SmoothBox_SelectionChanged"
                              MinWidth="146" MaxWidth="170" Padding="8,4"
                              Foreground="White" Background="#33000000" BorderBrush="#4DFFFFFF"
                              ToolTipService.ToolTip="Повышение FPS по движению. Не меняет режим Anime4K."/>
                    <ComboBox x:Name="QualityBox" SelectionChanged="QualityBox_SelectionChanged"
                              MinWidth="118" MaxWidth="180" Padding="8,4"
                              Foreground="White" Background="#33000000" BorderBrush="#4DFFFFFF"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="PlaybackWarningText" Text="⚠ Пропуски" Foreground="#FFFF7070"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               Visibility="Collapsed" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="StatsButton" Click="StatsButton_Click" Padding="8"
                                  Background="Transparent" BorderThickness="0"
                                  ToolTipService.ToolTip="Статистика воспроизведения"
                                  AutomationProperties.Name="Статистика воспроизведения">
                        <FontIcon Glyph="&#xE946;" Foreground="White" FontSize="15"/>
                    </ToggleButton>
                    <Button x:Name="TopBarMoreButton" Click="TopBarMoreButton_Click" Visibility="Collapsed"
                            Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8"
                            ToolTipService.ToolTip="Меню плеера" AutomationProperties.Name="Меню плеера">
                        <FontIcon Glyph="&#xE712;" Foreground="White" FontSize="17"/>
                    </Button>
                    <ToggleButton x:Name="PinButton" Click="PinButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                        <FontIcon x:Name="PinIcon" Glyph="&#xE718;" Foreground="White" FontSize="15"/>
                    </ToggleButton>
                    <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                        <FontIcon Glyph="&#xE921;" Foreground="White" FontSize="15"/>
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                        <FontIcon Glyph="&#xE8BB;" Foreground="White" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Button x:Name="BigPlayButton" Click="PlayPauseButton_Click"
                            Background="#E6000000" CornerRadius="44" Width="88" Height="88"
                            BorderBrush="#B3FFFFFF" BorderThickness="2" Padding="0" Opacity="1">
                        <FontIcon x:Name="BigPlayIcon" Glyph="&#xE768;" Foreground="White" FontSize="40"/>
                    </Button>
                </StackPanel>
                <Border x:Name="PlaybackStatsPanel" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,10,16,0"
                        Background="#D9000000" CornerRadius="8" Padding="12,9" MaxWidth="310">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Статистика воспроизведения" Foreground="White"
                                   FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="StatsFpsText" Text="Отрисовка: —" Foreground="#FF9FE6A0"
                                   FontFamily="Consolas" FontSize="12"/>
                        <TextBlock x:Name="StatsDroppedText" Text="Пропуски: —" Foreground="White"
                                   FontFamily="Consolas" FontSize="12"/>
                        <TextBlock x:Name="StatsDetailText" Text="Ожидание воспроизведения" Foreground="#FFDDDDDD"
                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" MaxWidth="285"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="BottomBar" Grid.Row="2" Padding="16,10,16,10" Background="#B3000000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="10" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="0:00" Foreground="White" FontSize="12"
                               VerticalAlignment="Center" MinWidth="44"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="0"
                            Style="{StaticResource PlayerSlider}"
                            ValueChanged="SeekSlider_ValueChanged"
                            PointerPressed="SeekSlider_PointerPressed"
                            PointerReleased="SeekSlider_PointerReleased"
                            PointerCanceled="SeekSlider_PointerCanceled"
                            PointerCaptureLost="SeekSlider_PointerCaptureLost"/>
                    <TextBlock x:Name="TotalTimeText" Text="0:00" Foreground="White" FontSize="12"
                               VerticalAlignment="Center" MinWidth="44" Grid.Column="2"/>
                </Grid>

                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" Foreground="White" FontSize="18"/>
                        </Button>
                        <Button x:Name="PrevButton" Click="PrevButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE76B;" Foreground="White" FontSize="16"/>
                        </Button>
                        <Button x:Name="NextButton" Click="NextButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE76C;" Foreground="White" FontSize="16"/>
                        </Button>

                        <Border x:Name="Sep1" Background="#33FFFFFF" Width="1" Height="22" Margin="12,0,12,0"/>

                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" Foreground="#D9FFFFFF" FontSize="15" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="110"
                                Style="{StaticResource PlayerSlider}" ValueChanged="VolumeSlider_ValueChanged" Margin="6,0,0,0"/>

                        <Button x:Name="MuteButton" Click="MuteButton_Click" Background="Transparent" BorderThickness="0" Padding="6">
                            <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" Foreground="#D9FFFFFF" FontSize="15"/>
                        </Button>

                        <Border x:Name="Sep2" Background="#33FFFFFF" Width="1" Height="22" Margin="10,0,10,0"/>

                        <ComboBox x:Name="SubtitlesBox" SelectionChanged="SubtitlesBox_SelectionChanged"
                                  MinWidth="140" MaxWidth="220" Padding="8,4"
                                  Foreground="White" Background="#33000000" BorderBrush="#4DFFFFFF"/>

                        <Button x:Name="SpeedButton" Click="SpeedButton_Click" Background="#33FFFFFF" BorderThickness="0"
                                CornerRadius="8" Padding="10,5" Margin="12,0,0,0">
                            <TextBlock x:Name="SpeedText" Text="1x" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Button>

                        <Button x:Name="ZoomButton" Click="ZoomButton_Click" Background="#33FFFFFF" BorderThickness="0"
                                CornerRadius="8" Padding="10,5" Margin="8,0,0,0">
                            <TextBlock x:Name="ZoomText" Text="Auto" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button x:Name="SkipOpeningButton" Click="SkipOpeningButton_Click" Background="#33FFFFFF" BorderThickness="0"
                                CornerRadius="8" Padding="8,5" Margin="8,0,0,0"
                                ToolTipService.ToolTip="Пропустить опенинг (интервал задаётся в настройках)"
                                AutomationProperties.Name="Пропустить опенинг">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB9D;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="15"/>
                                <TextBlock x:Name="SkipOpeningText" Text="+1:25" Foreground="White"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="DownloadButton" Click="DownloadButton_Click" Background="Transparent" BorderThickness="0" Padding="8" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE896;" Foreground="White" FontSize="15"/>
                        </Button>
                        <Button x:Name="ExternalButton" Click="ExternalButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE8AD;" Foreground="White" FontSize="15"/>
                        </Button>
                        <Button x:Name="FullscreenButton" Click="FullscreenButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" Foreground="White" FontSize="15"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="BufferingStatusRow" Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" Visibility="Collapsed">
                    <ProgressRing x:Name="BufferingRing" Width="16" Height="16" IsActive="False" Foreground="White"/>
                    <TextBlock x:Name="BufferingText" Text="Буферизация..." Foreground="#B3FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
