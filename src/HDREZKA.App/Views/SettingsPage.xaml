<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Padding="36,16,36,24" Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold"/>

            <Expander x:Name="ConnectionExpander" IsExpanded="True" Margin="0,12,0,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock x:Name="ConnectionHeader" Style="{StaticResource SectionHeader}"/>
                </Expander.Header>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="MirrorHeader" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <TextBox x:Name="MirrorBox" PlaceholderText="https://hdrzk.org/" LostFocus="MirrorBox_LostFocus" MaxWidth="480" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="MirrorHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button x:Name="AutoMirrorButton" Click="AutoMirrorButton_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="MirrorStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
                    </StackPanel>
                    <TextBlock x:Name="HeadersHeader" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <ToggleSwitch x:Name="HeadersToggle" Toggled="HeadersToggle_Toggled"/>
                    <TextBlock x:Name="HeadersHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Expander>

            <Expander x:Name="InterfaceExpander" IsExpanded="True"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock x:Name="InterfaceHeader" Style="{StaticResource SectionHeader}"/>
                </Expander.Header>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LanguageHeader" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <ComboBox x:Name="LanguageBox" MinWidth="220" SelectionChanged="LanguageBox_SelectionChanged"/>

                    <Button x:Name="OpenAppearanceButton" Click="OpenAppearanceButton_Click"
                            Margin="0,12,0,4" HorizontalAlignment="Left" MinHeight="38">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xE790;" FontSize="16"/>
                            <TextBlock x:Name="OpenAppearanceText" VerticalAlignment="Center"/>
                            <FontIcon Glyph="&#xE76C;" FontSize="13" Opacity="0.6"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="AppearanceMovedHint" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBlock x:Name="HomeHeader" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <TextBlock x:Name="HomeHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="640"/>
                    <ListView x:Name="HomeSectionsList" Margin="0,8,0,0" MaxWidth="480"
                              HorizontalAlignment="Left" Padding="0" BorderThickness="0"
                              SelectionMode="None" AllowDrop="True" CanDragItems="True"
                              CanReorderItems="True"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="44"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="Margin" Value="0,2,0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </Expander>

            <Expander x:Name="PlaybackExpander" IsExpanded="True"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock x:Name="PlaybackHeader" Style="{StaticResource SectionHeader}"/>
                </Expander.Header>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="QualityHeader" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <ComboBox x:Name="QualityBox" MinWidth="220" SelectionChanged="QualityBox_SelectionChanged"/>
                    <CheckBox x:Name="DirectPlayCheck" Margin="0,8,0,0" Checked="DirectPlayCheck_Changed" Unchecked="DirectPlayCheck_Changed"/>
                    <CheckBox x:Name="ShowPlaybackStatsCheck" Content="Показывать статистику воспроизведения"
                              Margin="0,12,0,0" Checked="ShowPlaybackStatsCheck_Changed"
                              Unchecked="ShowPlaybackStatsCheck_Changed"/>
                    <TextBlock Text="Отрисовка кадров, пропуски, разрешение и режимы обработки.
                                    Статистику также можно переключать кнопкой ⓘ в плеере."
                               FontSize="12" TextWrapping="Wrap" MaxWidth="640"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Управление плеером" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <TextBlock Text="Шаг перемотки стрелками клавиатуры (← и →) задаётся отдельно."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <NumberBox x:Name="SeekBackBox" Header="Назад, сек." Width="158"
                                   Minimum="1" Maximum="120" SmallChange="5" SpinButtonPlacementMode="Inline"
                                   ValueChanged="SeekBackBox_ValueChanged"/>
                        <NumberBox x:Name="SeekForwardBox" Header="Вперёд, сек." Width="158"
                                   Minimum="1" Maximum="120" SmallChange="5" SpinButtonPlacementMode="Inline"
                                   ValueChanged="SeekForwardBox_ValueChanged"/>
                    </StackPanel>
                    <TextBlock Text="Скорость воспроизведения" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <NumberBox x:Name="DefaultSpeedBox" Header="По умолчанию, ×" Width="178"
                               Minimum="0.5" Maximum="3" SmallChange="0.25" LargeChange="0.5"
                               SpinButtonPlacementMode="Inline" ValueChanged="DefaultSpeedBox_ValueChanged"/>
                    <CheckBox x:Name="RememberSpeedCheck" Content="Запоминать скорость, выбранную в плеере"
                              Checked="RememberSpeedCheck_Changed" Unchecked="RememberSpeedCheck_Changed"/>
                    <TextBlock Text="Если выключено, каждый новый запуск плеера использует скорость по умолчанию."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Пропуск опенинга" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <NumberBox x:Name="OpeningSkipBox" Header="Перемотка вперёд, секунд" Minimum="1" Maximum="600"
                               SmallChange="5" LargeChange="30" SpinButtonPlacementMode="Inline"
                               Width="240" HorizontalAlignment="Left" ValueChanged="OpeningSkipBox_ValueChanged"/>
                    <TextBlock Text="По умолчанию 85 секунд (1:25). Кнопка находится в нижней панели плеера."
                               FontSize="12" TextWrapping="Wrap" MaxWidth="640" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Expander>

            <Expander x:Name="UpdateExpander" IsExpanded="False"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock x:Name="UpdateHeader" Style="{StaticResource SectionHeader}"/>
                </Expander.Header>
                <StackPanel Spacing="4">
                    <TextBlock Text="Канал обновлений" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <ComboBox x:Name="UpdateChannelBox" MinWidth="240"
                              SelectionChanged="UpdateChannelBox_SelectionChanged">
                        <ComboBoxItem Content="Стабильный (main)"/>
                        <ComboBoxItem Content="Тестовый (пререлизы)"/>
                    </ComboBox>
                    <TextBlock x:Name="InstalledBuildText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="640"/>
                    <Button x:Name="CopyBuildButton" Content="Копировать сведения о сборке"
                            Click="CopyBuildButton_Click" HorizontalAlignment="Left"/>
                    <Button x:Name="VersionHistoryButton" Content="История версий"
                            Click="VersionHistoryButton_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="CopiedBuildStatusText" FontSize="12" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="UpdateStatusText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="640"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button x:Name="CheckUpdatesButton" Click="CheckUpdatesButton_Click"/>
                        <Button x:Name="InstallUpdateButton" Content="Скачать и установить"
                                Click="InstallUpdateButton_Click" Visibility="Collapsed"
                                Style="{ThemeResource AccentButtonStyle}"/>
                        <Button x:Name="CancelUpdateButton" Content="Отменить"
                                Click="CancelUpdateButton_Click" Visibility="Collapsed"/>
                    </StackPanel>
                    <ProgressBar x:Name="UpdateDownloadProgress" Minimum="0" Maximum="100"
                                 Visibility="Collapsed" Height="6" MaxWidth="480" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="UpdateReleaseNotesText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="640"/>
                    <TextBlock Text="Обновление загружается только из релизов нашего GitHub. Контрольная сумма SHA-256 обязательна. Перед заменой файлов сохраняется предыдущая версия."
                               FontSize="11" TextWrapping="Wrap" MaxWidth="640"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Expander>

            <Expander x:Name="AboutExpander" IsExpanded="True"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock x:Name="AboutHeader" Style="{StaticResource SectionHeader}"/>
                </Expander.Header>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,8,0,0" MaxWidth="640"/>
                    <Button x:Name="LogoutButton" Click="LogoutButton_Click" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
