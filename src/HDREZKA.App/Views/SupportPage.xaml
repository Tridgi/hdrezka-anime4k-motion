<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.SupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="22" Padding="28,18,28,36"
                    MaxWidth="880" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock x:Name="TitleText" FontSize="28"
                           FontWeight="Bold"/>
                <TextBlock x:Name="SupportDescriptionText" FontSize="13"
                           MaxWidth="660" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Boosty card with a scannable QR alongside the direct link.
                 The QR moves below the description on narrow windows. -->
            <Border CornerRadius="18" Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" HorizontalAlignment="Stretch">
                <StackPanel Spacing="17">
                    <Border Height="4" Width="60" CornerRadius="2"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            HorizontalAlignment="Left"/>

                    <Grid x:Name="BoostyContentLayout" ColumnSpacing="22"
                          RowSpacing="18"
                          SizeChanged="BoostyContentLayout_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="19">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Border Width="54" Height="54" CornerRadius="14"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="25"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="BoostyTitleText"
                                               FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Text="boosty.to/tridgi" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="BoostyDescriptionText"
                                       FontSize="14" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Button x:Name="BoostyButton" Click="BoostyButton_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" MinHeight="42"
                                    MinWidth="215" CornerRadius="10" Padding="18,10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="BoostyButtonText" FontWeight="SemiBold"/>
                                    <FontIcon Glyph="&#xE72A;" FontSize="15"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border x:Name="BoostyQrCard" Grid.Row="0" Grid.Column="1"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                CornerRadius="14" Padding="10"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="8">
                                <Border Background="White" Padding="8" CornerRadius="8">
                                    <Image x:Name="BoostyQrImage" Width="152" Height="152"
                                           Stretch="Uniform"
                                           ImageFailed="BoostyQrImage_ImageFailed"
                                           AutomationProperties.Name="Boosty QR"/>
                                </Border>
                                <TextBlock x:Name="BoostyQrCaption" FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
