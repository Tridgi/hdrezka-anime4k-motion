<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.SupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="36,24,36,36" MaxWidth="780" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold"/>
                <TextBlock x:Name="SupportDescriptionText" FontSize="13" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Border CornerRadius="12" Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="BoostyTitleText" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BoostyDescriptionText" FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Spacing="12" HorizontalAlignment="Left">
                        <Border CornerRadius="10" Padding="10"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Image x:Name="BoostyQrImage" Width="148" Height="148"
                                   Stretch="Uniform" ImageFailed="BoostyQrImage_ImageFailed"/>
                        </Border>
                        <Button x:Name="BoostyButton" Click="BoostyButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Left" MinWidth="170" MinHeight="38"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="DonorHeader" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DonorHint" FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox x:Name="DonorBox" MinWidth="180" MaxWidth="280"
                                 HorizontalAlignment="Left" LostFocus="DonorBox_LostFocus"
                                 VerticalAlignment="Center"/>
                        <Button x:Name="ApplyDonorButton" Click="ApplyDonorButton_Click"
                                MinHeight="34" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="DonorStatusText" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="DonorPerksText" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>