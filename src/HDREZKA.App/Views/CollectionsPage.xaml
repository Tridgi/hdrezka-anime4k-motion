<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HDREZKA.App.Controls"
    xmlns:api="using:HDREZKA.Core.Api"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="28,12,28,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold"/>

        <!-- Browse is the landing view. No arbitrary first folder is opened
             and no horizontally scrolling selection strip is needed. -->
        <ScrollViewer x:Name="BrowseScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="BrowsePanel" Spacing="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="BrowseHint" FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="BrowseSearchBox" Width="330" MaxWidth="480"
                             HorizontalAlignment="Left" MinHeight="38"
                             TextChanged="BrowseSearchBox_TextChanged">
                        <TextBox.Header>
                            <TextBlock x:Name="BrowseSearchLabel" FontSize="12"/>
                        </TextBox.Header>
                    </TextBox>
                </StackPanel>
                <GridView x:Name="FoldersGrid" SelectionMode="None"
                          IsItemClickEnabled="False"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,14,18"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="IsTabStop" Value="False"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
                <StackPanel x:Name="BrowseStatePanel" HorizontalAlignment="Center"
                            Spacing="12" Visibility="Collapsed" Margin="0,24,0,24">
                    <ProgressRing x:Name="BrowseRing" IsActive="False"
                                  Width="32" Height="32" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BrowseStateText" FontSize="13"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="BrowseRetryButton" Click="BrowseRetryButton_Click"
                            Visibility="Collapsed" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Selected folder is a proper detail view with a clear return path. -->
        <Grid x:Name="CollectionDetailsPanel" Grid.Row="1"
              Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackToCollectionsButton"
                            Click="BackToCollectionsButton_Click"
                            Padding="10,7" MinWidth="0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE72B;" FontSize="15"/>
                            <TextBlock x:Name="BackToCollectionsText"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="3"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedCollectionTitle"
                                   FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxLines="2"/>
                        <TextBlock x:Name="SelectedCollectionCount"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ItemsScroll" Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          ViewChanged="ItemsScroll_ViewChanged">
                <StackPanel>
                    <GridView x:Name="ItemsGrid" SelectionMode="None"
                              IsItemClickEnabled="False"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,12,16"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="IsTabStop" Value="False"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="api:MovieSimple">
                                <controls:MovieCard Movie="{x:Bind}"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <StackPanel x:Name="MorePanel" HorizontalAlignment="Center"
                                Margin="0,4,0,24" Spacing="8" Visibility="Collapsed">
                        <ProgressRing x:Name="MoreRing" IsActive="False"
                                      Width="28" Height="28"/>
                        <Button x:Name="MoreButton" Click="MoreButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>

                    <Border x:Name="StatePanel" CornerRadius="14" Padding="18"
                            HorizontalAlignment="Stretch" MaxWidth="720"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <ProgressRing x:Name="LoadingRing" IsActive="True"
                                          Width="35" Height="35"/>
                            <TextBlock x:Name="StateText"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="10"
                                        HorizontalAlignment="Center">
                                <Button x:Name="RetryButton" Click="RetryButton_Click"
                                        Style="{ThemeResource AccentButtonStyle}"/>
                                <Button x:Name="DetailsBackButton"
                                        Click="BackToCollectionsButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
