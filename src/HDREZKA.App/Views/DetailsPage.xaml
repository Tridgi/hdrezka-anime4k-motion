<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HDREZKA.App.Controls"
    xmlns:api="using:HDREZKA.Core.Api"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="WatchAlsoTemplate" x:DataType="api:MovieSimple">
            <controls:MovieCard Movie="{x:Bind}"/>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MainPanel" Padding="36,16,36,24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- A compact top hero: only poster and facts share columns.
                     Everything below (description, episode selection) spans full width. -->
                <Grid x:Name="HeaderGrid" ColumnSpacing="24" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="PosterPanel" Width="232" Spacing="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border CornerRadius="12">
                            <Image x:Name="PosterImage" Width="232" Height="348" Stretch="UniformToFill"/>
                        </Border>
                        <Button x:Name="TrailerButton" Click="TrailerButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="38">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE714;" FontSize="16"/>
                                <TextBlock x:Name="TrailerText" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <!-- Static two-ring halo: zero animation or per-frame work. -->
                        <Grid Margin="4">
                            <Border x:Name="WatchGlowOuter" Margin="-4" CornerRadius="12"
                                    IsHitTestVisible="False" Opacity="0.25"/>
                            <Border x:Name="WatchGlowInner" Margin="-2" CornerRadius="10"
                                    IsHitTestVisible="False" Opacity="0.4"/>
                            <Button x:Name="WatchButton" Click="WatchButton_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="42">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="16"/>
                                    <TextBlock x:Name="WatchText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button x:Name="BookmarkButton" Click="BookmarkButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="38">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE734;" FontSize="16"/>
                                <TextBlock x:Name="BookmarkText" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="TrackButton" Click="TrackButton_Click"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="38">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE91C;" FontSize="16"/>
                                <TextBlock x:Name="TrackText" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel x:Name="InfoPanel" Grid.Column="1" Spacing="10">
                        <TextBlock x:Name="TitleText" FontSize="30" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OrigTitleText" FontSize="16"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- Ratings and age travel together, instead of the
                             age being pushed to the far right of a star column. -->
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Left" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <StackPanel x:Name="RatingsPanel" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center"/>
                                <Border x:Name="AgeRatingBorder" CornerRadius="10"
                                        Padding="10,7" BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="AgeRatingText" FontSize="15" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Label on the metadata baseline; only stars are a badge. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="YourRatingLabelColumn" Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="YourRatingHeader" Grid.Column="0" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ScrollViewer Grid.Column="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                                          HorizontalAlignment="Left">
                                <Border x:Name="UserRatingBorder" CornerRadius="10" Padding="8,5"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel x:Name="UserRatingPanel" Orientation="Horizontal"
                                                Spacing="8" Visibility="Collapsed"/>
                                </Border>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel x:Name="MetaPanel" Spacing="8" Margin="0,8,0,0"/>
                        <Border x:Name="DescriptionPanel" CornerRadius="12" Margin="0,8,0,0"
                                Padding="12,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" MaxLines="3"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button x:Name="DescriptionExpandButton" Click="DescriptionExpandButton_Click"
                                        HorizontalAlignment="Center" BorderThickness="0" Background="Transparent"
                                        Padding="10,4" Content="Показать полностью"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border x:Name="PlaybackChoiceBorder" Grid.Row="1" CornerRadius="12" Padding="16"
                        SizeChanged="PlaybackChoiceBorder_SizeChanged"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel x:Name="PlaybackChoicePanel" Spacing="14">
                        <!-- Two independent selectors. At narrow widths the voice
                             selector drops beneath season; neither is clipped. -->
                        <Grid x:Name="ChoiceGrid" ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SeasonColumn" Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="SeasonsPanel" Grid.Column="0" Spacing="7"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="SeasonsHeader" FontWeight="SemiBold"/>
                                <ComboBox x:Name="SeasonBox" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          SelectionChanged="SeasonBox_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="VoicesPanel" Grid.Column="1" Spacing="7"
                                        Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock x:Name="VoicesHeader" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="VoicesRatingButton" Click="VoicesRatingButton_Click"
                                            Visibility="Collapsed" Background="Transparent"
                                            BorderThickness="0" Padding="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE946;" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ComboBox x:Name="VoiceBox" HorizontalAlignment="Left"
                                              HorizontalContentAlignment="Left"
                                              MinWidth="185" MaxWidth="330" MaxDropDownHeight="380"
                                              SelectionChanged="VoiceBox_SelectionChanged"/>
                                    <Button x:Name="InlineWatchButton" Click="WatchButton_Click"
                                            Width="40" Height="40" Padding="0" MinWidth="0" MinHeight="0"
                                            VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}">
                                        <FontIcon Glyph="&#xE768;" FontSize="16"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="EpisodesPanel" Spacing="8" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock x:Name="EpisodesHeader" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="SeasonDownloadButton" Click="SeasonDownloadButton_Click"
                                        Visibility="Collapsed" VerticalAlignment="Center" Padding="10,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE896;" FontSize="13"/>
                                        <TextBlock x:Name="SeasonDownloadText" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- Bounded dynamically by the playback card, fills to the edge. -->
                            <ItemsControl x:Name="EpisodesList" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="46" ItemHeight="40"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="EpisodeRightClickHint" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ActionsRow" Grid.Row="2" Orientation="Horizontal"
                            Spacing="10" Visibility="Collapsed">
                    <Button x:Name="DownloadButton" Click="DownloadButton_Click" MinHeight="36"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="15"/>
                            <TextBlock x:Name="DownloadText"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border x:Name="ScheduleCard" Grid.Row="3" Visibility="Collapsed"
                        CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel x:Name="SchedulePanel" Spacing="8">
                    <TextBlock x:Name="ScheduleHeader" Style="{StaticResource SectionHeader}"/>
                    <Border x:Name="ScheduleCountdownBadge" Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12,6" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock x:Name="ScheduleCountdownText" Foreground="White" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="ScheduleGroupText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ScheduleList" Spacing="0"/>
                    <Button x:Name="ScheduleMoreButton" Click="ScheduleMoreButton_Click" Visibility="Collapsed"
                            Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Left"/>
                </StackPanel>

                </Border>
                <StackPanel x:Name="CommentsSection" Grid.Row="4" Spacing="10" Margin="0,20,0,0" Visibility="Collapsed">                    <ToggleButton x:Name="CommentsToggle" Click="CommentsToggle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE90A;" FontSize="16"/>
                            <TextBlock x:Name="CommentsToggleText"/>
                        </StackPanel>
                    </ToggleButton>

                    <StackPanel x:Name="CommentsPanel" Spacing="10" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CommentInput" PlaceholderText="Comment…" MaxLength="2000" HorizontalAlignment="Stretch" MaxWidth="640" AcceptsReturn="False" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" x:Name="CommentSendButton" Click="CommentSendButton_Click" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <StackPanel x:Name="CommentsList" Spacing="4"/>
                        <Button x:Name="CommentsMoreButton" Click="CommentsMoreButton_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="WatchAlsoPanel" Grid.Row="5" Spacing="0" Margin="0,20,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="WatchAlsoHeader" Style="{StaticResource RowHeaderText}"/>
                    <ListView x:Name="WatchAlsoGrid" SelectionMode="None" IsItemClickEnabled="False"
                              ItemTemplate="{StaticResource WatchAlsoTemplate}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,12,16"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Top"/>
                                <Setter Property="IsTabStop" Value="False"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" Width="44" Height="44"/>
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon Glyph="&#xE783;" FontSize="36"/>
            <TextBlock x:Name="ErrorText" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
            <Button x:Name="RetryButton" Click="RetryButton_Click" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Page>
