<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HDREZKA.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HDREZKA.App">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="CustomTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInsetColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightInsetColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation actions belong to the title bar, not the side pane. -->
            <StackPanel x:Name="TitleBarActions" Grid.Column="1" Orientation="Horizontal"
                        Spacing="2" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button x:Name="AppBackButton" Width="30" Height="28"
                        BorderThickness="0" Background="Transparent" Padding="0"
                        Click="AppBackButton_Click" IsEnabled="False"
                        ToolTipService.ToolTip="Назад" AutomationProperties.Name="Назад">
                    <!-- Explicit left-pointing arrow: no dependency on ambiguous Segoe glyphs. -->
                    <Path Data="M 16,8 L 4,8 M 9,3 L 4,8 L 9,13"
                          Width="19" Height="16" Stretch="None"
                          Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.25"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="AppPaneButton" Width="30" Height="28"
                        BorderThickness="0" Background="Transparent" Padding="0"
                        Click="AppPaneButton_Click"
                        ToolTipService.ToolTip="Боковая панель"
                        AutomationProperties.Name="Скрыть или показать меню">
                    <!-- Compact split-pane icon, similar to modern editor sidebars. -->
                    <!-- Open: the occupied left rail. Closed: a thin collapsed edge. -->
                    <Path x:Name="AppPaneOpenGlyph"
                          Data="M 3,2.5 L 15,2.5 Q 17,2.5 17,4.5 L 17,12.5 Q 17,14.5 15,14.5 L 3,14.5 Q 1,14.5 1,12.5 L 1,4.5 Q 1,2.5 3,2.5 Z M 6,2.5 L 6,14.5"
                          Width="18" Height="17" Stretch="None" Fill="Transparent"
                          Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <Path x:Name="AppPaneClosedGlyph" Visibility="Collapsed"
                          Data="M 3,2.5 L 15,2.5 Q 17,2.5 17,4.5 L 17,12.5 Q 17,14.5 15,14.5 L 3,14.5 Q 1,14.5 1,12.5 L 1,4.5 Q 1,2.5 3,2.5 Z M 4,2.5 L 4,14.5"
                          Width="18" Height="17" Stretch="None" Fill="Transparent"
                          Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
            </StackPanel>
            <Grid x:Name="TitleBarDragRegion" Grid.Column="2" Background="Transparent">
                <TextBlock x:Name="AppTitleText" Text="HDREZKA" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsBackEnabled="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="NavView_SelectionChanged"
            BackRequested="NavView_BackRequested"
            DisplayModeChanged="NavView_DisplayModeChanged">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    PlaceholderText="Search"
                    QueryIcon="Find"
                    Text="{x:Bind SearchText, Mode=OneWay}"
                    QuerySubmitted="SearchBox_QuerySubmitted" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Tag="Home" Content="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavCatalog" Tag="Catalog" Content="Catalog">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavBookmarks" Tag="Bookmarks" Content="Bookmarks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavContinue" Tag="Continue" Content="Continue">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavCollections" Tag="Collections" Content="Collections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavAppearance" Tag="Appearance" Content="Оформление">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" FontSize="17"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSupport" Tag="Support" Content="Поддержка проекта">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Favorite"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavUpdates" Tag="Updates" Content="Updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91C;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="UpdatesBadge" Visibility="Collapsed"/>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAccount" Tag="Account" Content="Account">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettings" Tag="Settings" Content="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Floating downloads progress: visible while anything downloads -->
        <Button x:Name="DownloadsFab" Grid.Row="0" Grid.RowSpan="2" Click="DownloadsButton_Click"
                Width="56" Height="56" CornerRadius="28" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,24"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="0" Visibility="Collapsed">
            <Grid Width="40" Height="40">
                <ProgressRing x:Name="DownloadsRing" Width="40" Height="40"
                              Minimum="0" Maximum="100" IsIndeterminate="False"
                              Foreground="White" Background="#44FFFFFF"/>
                <TextBlock x:Name="DownloadsCountText" FontSize="15" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Button>
        <!-- Explicit full-window modal layer. Unlike ContentDialog.Popup, this
             is centred over RootGrid (title bar + NavigationView), not the page. -->
        <Grid x:Name="CenteredModalLayer" Grid.Row="0" Grid.RowSpan="2"
              Visibility="Collapsed" HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" Background="#B0000000"
              KeyDown="CenteredModalLayer_KeyDown">
            <Border x:Name="CenteredModalCard" Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="22" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="CenteredModalTitle" Grid.Row="0"
                               FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ContentPresenter x:Name="CenteredModalBody" Grid.Row="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>
                    <Button x:Name="CenteredModalCloseButton" Grid.Row="2"
                            Content="Закрыть" MinWidth="120"
                            HorizontalAlignment="Right" Click="CenteredModalCloseButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
