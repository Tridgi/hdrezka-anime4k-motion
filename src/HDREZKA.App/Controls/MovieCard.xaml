<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HDREZKA.App.Controls.MovieCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button x:Name="CardButton" Padding="2" Background="Transparent" BorderThickness="0"
            VerticalAlignment="Top" HorizontalAlignment="Left"
            Click="CardButton_Click"
            PointerEntered="CardButton_PointerEntered"
            PointerExited="CardButton_PointerExited"
            PointerPressed="CardButton_PointerPressed"
            PointerReleased="CardButton_PointerReleased"
            UseSystemFocusVisuals="True">
        <!-- Default WinUI Button hover states tint the entire poster card grey.
             Keep a transparent hit target and the system keyboard focus indicator. -->
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="Transparent" Padding="{TemplateBinding Padding}"
                        CornerRadius="12">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
            </ControlTemplate>
        </Button.Template>
        <Grid x:Name="OuterGrid" Width="130">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="92"/>
            </Grid.RowDefinitions>

            <Grid x:Name="PosterGrid" Width="130" Height="195">
                <Border x:Name="PosterClip" CornerRadius="12" Background="#22000000">
                    <Grid>
                        <Image x:Name="PosterImage" Stretch="UniformToFill"/>
                        <Border x:Name="HoverOverlay" Background="Transparent" CornerRadius="12" Opacity="0">
                            <FontIcon Glyph="&#xE768;" Foreground="White" FontSize="32"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- HDREZKA score: just above season / watched badge. -->
                <Border x:Name="RatingBadge" CornerRadius="8" Padding="7,4"
                        Background="#B71F9568"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Margin="0,0,6,35">
                    <TextBlock x:Name="RatingText" FontSize="11" FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <Border x:Name="InfoBadge" Style="{StaticResource InfoBadge}">
                    <TextBlock x:Name="InfoText" Style="{StaticResource InfoBadgeText}"/>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="4,6,4,0" Spacing="2">
                <Grid>
                    <TextBlock x:Name="TitleText" Style="{StaticResource CardTitleText}"
                               Height="40" VerticalAlignment="Top"/>

                </Grid>
                <TextBlock x:Name="DetailsText" Style="{StaticResource CardDetailsText}"
                           Height="32" VerticalAlignment="Top"/>
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
