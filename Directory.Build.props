<Project>

  <!--
    Единственный источник версии приложения.
    При выпуске релиза меняется ТОЛЬКО здесь; значение попадает в:
      * exe/dll (AssemblyVersion / FileVersion / InformationalVersion),
      * User-Agent HTTP-запросов (HDREZKA.Core.Api.BuildInfo),
      * экран «Настройки» (UpdateService.CurrentVersion).
    Версия синхронизируется с README и CHANGELOG при подготовке релиза.
    Portable-архивы создаются workflow; отдельного Inno Setup-инсталлятора нет.
  -->
  <PropertyGroup>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <Version>2.2.0-preview.1</Version>
    <FileVersion>2.2.0.1</FileVersion>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <InformationalVersion>2.2.0-preview.1</InformationalVersion>
    <Product>HDREZKA Anime4K Motion 2.2 Preview</Product>
    <Company>HDREZKA Anime4K Motion contributors</Company>
    <Copyright>Copyright (c) 2026. Portions based on HDrezka for macOS, MIT License (c) 2025 voidboost.</Copyright>
  </PropertyGroup>

</Project>
